#!/bin/sh
set -eu
if ! command -v i3lock >/dev/null 2>&1; then
    printf 'NSD: install i3lock to lock the screen.\n' >&2
    command -v notify-send >/dev/null 2>&1 && notify-send -u critical 'NSD // LOCK UNAVAILABLE' 'Install i3lock. The screen has NOT been locked.'
    exit 1
fi
exec i3lock -n -c 090D16
